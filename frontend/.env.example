# Render backend URL, including /api
VITE_API_URL=https://convertflow-backend.onrender.com/api

# Your production Vercel/custom domain
VITE_SITE_URL=https://convertflow-seven-delta.vercel.app

# n8n webhook used only by /admin to request Render status/on/off.
# Keep the Render API key and admin password inside n8n, never in Vercel.
VITE_ADMIN_CONTROL_WEBHOOK_URL=https://n8n-2-rgl6.onrender.com/webhook/convertflow-render-control

# Optional Google Analytics 4 tag ID, for example G-XXXXXXXXXX
VITE_GA_ID=

# Google Search Console HTML-tag verification value
VITE_GOOGLE_SITE_VERIFICATION=
