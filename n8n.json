{
  "name": "ConvertFlow - Authentication and Maintenance Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "convertflow-auth-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "auth-webhook",
      "name": "ConvertFlow auth webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{
            "leftValue": "={{ $json.headers['x-convertflow-secret'] }}",
            "rightValue": "={{ $env.CONVERTFLOW_WEBHOOK_SECRET }}",
            "operator": { "type": "string", "operation": "equals" }
          }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "auth-secret",
      "name": "Check ConvertFlow secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [420, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{
            "leftValue": "={{ $json.body.type }}",
            "rightValue": "maintenance_alert",
            "operator": { "type": "string", "operation": "equals" }
          }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-maintenance",
      "name": "Is maintenance alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 240]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.CONVERTFLOW_FROM_EMAIL }}",
        "toEmail": "={{ $env.CONVERTFLOW_ADMIN_EMAIL }}",
        "subject": "ConvertFlow backend maintenance alert",
        "emailFormat": "text",
        "text": "=ConvertFlow backend health check failed.\n\nWebsite: {{ $json.body.website }}\nError: {{ $json.body.message }}\nStatus: {{ $json.body.status || 'unknown' }}\nTime: {{ $json.body.occurredAt }}\n\nPlease check the Render backend and its logs.",
        "options": {}
      },
      "id": "maintenance-email",
      "name": "Email administrator",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [860, 420],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "ConvertFlow SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":true}",
        "options": {}
      },
      "id": "maintenance-response",
      "name": "Respond maintenance success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1080, 420]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.CONVERTFLOW_FROM_EMAIL }}",
        "toEmail": "={{ $json.body.email }}",
        "subject": "={{ $json.body.type === 'password_reset' ? 'Reset your ConvertFlow password' : 'Your ConvertFlow verification code' }}",
        "emailFormat": "text",
        "text": "={{ $json.body.type === 'password_reset' ? 'Your ConvertFlow password reset code is ' + $json.body.code + '. It expires in ' + $json.body.expiresInMinutes + ' minutes. If you did not request a password reset, you can ignore this email.' : 'Your ConvertFlow security code is ' + $json.body.code + '. It expires in ' + $json.body.expiresInMinutes + ' minutes. If you did not request it, you can ignore this email.' }}",
        "options": {}
      },
      "id": "auth-email",
      "name": "Send authentication email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [860, 160],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "ConvertFlow SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":true}",
        "options": {}
      },
      "id": "auth-response",
      "name": "Respond authentication success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1080, 160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":false,\"message\":\"Unauthorized webhook\"}",
        "options": { "responseCode": 401 }
      },
      "id": "unauthorized-response",
      "name": "Respond unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [640, 620]
    }
  ],
  "connections": {
    "ConvertFlow auth webhook": {
      "main": [[{ "node": "Check ConvertFlow secret", "type": "main", "index": 0 }]]
    },
    "Check ConvertFlow secret": {
      "main": [
        [{ "node": "Is maintenance alert?", "type": "main", "index": 0 }],
        [{ "node": "Respond unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "Is maintenance alert?": {
      "main": [
        [{ "node": "Email administrator", "type": "main", "index": 0 }],
        [{ "node": "Send authentication email", "type": "main", "index": 0 }]
      ]
    },
    "Email administrator": {
      "main": [[{ "node": "Respond maintenance success", "type": "main", "index": 0 }]]
    },
    "Send authentication email": {
      "main": [[{ "node": "Respond authentication success", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "2"
}
