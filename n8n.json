{
  "name": "ConvertFlow - Send login verification code",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "convertflow-login-code",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "ConvertFlow login webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-convertflow-secret'] }}",
              "rightValue": "={{ $env.CONVERTFLOW_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-secret",
      "name": "Check webhook secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "fromEmail": "YOUR_VERIFIED_SENDER@example.com",
        "toEmail": "={{ $json.body.email }}",
        "subject": "Your ConvertFlow security code",
        "emailFormat": "text",
        "text": "=Your ConvertFlow security code is {{ $json.body.code }}. It expires in {{ $json.body.expiresInMinutes }} minutes. If you did not request it, you can ignore this email.",
        "options": {}
      },
      "id": "send-email",
      "name": "Send verification email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [700, 230],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "Replace with SMTP credential"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":true}",
        "options": {}
      },
      "id": "success-response",
      "name": "Respond success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [920, 230]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":false,\"message\":\"Unauthorized webhook\"}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "failure-response",
      "name": "Respond unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [700, 390]
    }
  ],
  "connections": {
    "ConvertFlow login webhook": {
      "main": [[{
        "node": "Check webhook secret",
        "type": "main",
        "index": 0
      }]]
    },
    "Check webhook secret": {
      "main": [
        [{
          "node": "Send verification email",
          "type": "main",
          "index": 0
        }],
        [{
          "node": "Respond unauthorized",
          "type": "main",
          "index": 0
        }]
      ]
    },
    "Send verification email": {
      "main": [[{
        "node": "Respond success",
        "type": "main",
        "index": 0
      }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
