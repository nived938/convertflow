PORT=5000
NODE_ENV=production
FRONTEND_URL=https://convertflow-seven-delta.vercel.app
JWT_SECRET=generate-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Staged AI image generation service. ConvertFlow calls stage 1 of Image-generative-AI.
IMAGE_GENERATIVE_AI_URL=https://convertflow-image-stage-01-gateway.onrender.com
# Optional: set the same secret on the 10 AI stages and here.
IMAGE_GENERATIVE_AI_SECRET=

# OpenRouter is used for Text-to-Audio only.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=flux-haley-en

# PhonePe Payment Gateway. Keep all credentials on the backend/Render only.
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=your-phonepe-client-id
PHONEPE_CLIENT_SECRET=your-phonepe-client-secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_CALLBACK_USERNAME=your-phonepe-callback-username
PHONEPE_CALLBACK_PASSWORD=your-phonepe-callback-password
PHONEPE_REDIRECT_URL=https://convertflow-seven-delta.vercel.app/donate?phonepe=return

N8N_LOGIN_WEBHOOK_URL=https://n8n-2-rgl6.onrender.com/webhook/convertflow-auth-email
N8N_MAINTENANCE_WEBHOOK_URL=https://n8n-2-rgl6.onrender.com/webhook/convertflow-auth-email
N8N_WEBHOOK_SECRET=generate-another-long-random-secret
LOGIN_CODE_TTL_MINUTES=10
