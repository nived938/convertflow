# ConvertFlow Backend Environment Example
# Copy this file to .env and replace placeholders with your real values.
# Keep secrets out of version control.

# -----------------------------------------------------------------------------
# Core app configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.example

# -----------------------------------------------------------------------------
# Authentication and security
# -----------------------------------------------------------------------------
ADMIN_CONTROL_SECRET=your_admin_control_secret
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=generate_a_long_random_secret_here
CONVERTFLOW_WEBHOOK_SECRET=your_convertflow_webhook_secret
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret
N8N_RENDER_CONTROL_SECRET=your_n8n_render_control_secret

# -----------------------------------------------------------------------------
# Webhooks / automation
# -----------------------------------------------------------------------------
N8N_LOGIN_WEBHOOK_URL=https://your-n8n-instance.example/webhook/convertflow-auth-email
N8N_MAINTENANCE_WEBHOOK_URL=https://your-n8n-instance.example/webhook/convertflow-auth-email
N8N_RENDER_CONTROL_WEBHOOK_URL=https://your-n8n-instance.example/webhook/convertflow-render-control

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key
deepai-api=your_deepai_api_key

# -----------------------------------------------------------------------------
# Payment provider (PhonePe)
# -----------------------------------------------------------------------------
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_REDIRECT_URL=https://your-frontend-url.example/donate?phonepe=return
PHONEPE_CALLBACK_USERNAME=your_phonepe_callback_username
PHONEPE_CALLBACK_PASSWORD=your_phonepe_callback_password

# -----------------------------------------------------------------------------
# Database / backend services
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - Keep all secrets in a real .env file, not in source control.
# - Use strong random values for JWT_SECRET and admin secrets.
# - For production, set PHONEPE_ENV=PRODUCTION and provide real merchant credentials.
