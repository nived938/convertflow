PORT=5000
NODE_ENV=production
FRONTEND_URL=https://convertflow-seven-delta.vercel.app
JWT_SECRET=generate-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Vertex AI / Gemini image generation.
# Use a Google Cloud / Vertex AI API key. A Google Cloud Free Trial can provide
# free credits for eligible workloads. Do not put this key in the frontend.
GOOGLE_API_KEY=your-google-vertex-ai-api-key
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# OpenRouter is used for Text-to-Audio only.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=flux-haley-en

N8N_LOGIN_WEBHOOK_URL=https://n8n-2-rgl6.onrender.com/webhook/convertflow-auth-email
N8N_MAINTENANCE_WEBHOOK_URL=https://n8n-2-rgl6.onrender.com/webhook/convertflow-auth-email
N8N_WEBHOOK_SECRET=generate-another-long-random-secret
LOGIN_CODE_TTL_MINUTES=10
